        "list": [
            { "text": "首页", "pagePath": "pages/home/index", "iconPath": "static/tabbar/global.png", "selectedIconPath": "static/tabbar/global_.png" },
            { "text": "消息", "pagePath": "pages/chats/index", "iconPath": "static/tabbar/global.png", "selectedIconPath": "static/tabbar/global_.png" },
            { "text": "我的", "pagePath": "pages/mine/index", "iconPath": "static/tabbar/global.png", "selectedIconPath": "static/tabbar/global_.png" }
        ]
    }
