{
    "easycom": { "autoscan": true, "custom": { "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue" } },
    "pages": [
        { "path": "pages/home/index", "style": { "navigationStyle": "custom" } },
        { "path": "pages/chats/index", "style": { "navigationBarTitleText": "消息" } },
        { "path": "pages/mine/index", "style": { "navigationStyle": "custom" } },
        { "path": "pages/login/index", "style": { "navigationBarTitleText": "登录" } }
